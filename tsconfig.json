{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "forceConsistentCasingInFileNames": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "@app/common/domain": ["libs/common/src/domain"],
      "@app/common/domain/*": ["libs/common/src/domain/*"],
      "@app/common/infrastructure": ["libs/common/src/infrastructure"],
      "@app/common/infrastructure/*": ["libs/common/src/infrastructure/*"],
      "@app/common/system": ["libs/common/src/system"],
      "@app/common/system/*": ["libs/common/src/system/*"]
    }
  },
  "include": ["apps/**/*", "libs/**/*"],
  "exclude": ["node_modules", "dist"]
}
