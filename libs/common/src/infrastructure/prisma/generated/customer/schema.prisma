generator client {
  provider      = "prisma-client-js"
  output        = "../../../libs/common/src/infrastructure/prisma/generated/customer"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique() // связь логическая, не FK
  firstName String?
  lastName  String?
  createdAt DateTime @default(now())
}
