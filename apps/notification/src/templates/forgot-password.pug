doctype html
html
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Forgot Password
    style.
      body {
        font-family: Arial, sans-serif;
        background-color: #eeeeee;
        padding: 20px;
        margin: 0;
      }
      .container {
        max-width: 600px;
        margin: 0 auto;
        background-color: #ffffff;
        border-radius: 10px;
        padding: 30px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.1);
      }
      .header {
        text-align: center;
        padding-bottom: 20px;
      }
      .header img {
        max-height: 60px;
        margin-bottom: 10px;
      }
      .header h1 {
        color: #333333;
      }
      .content {
        font-size: 16px;
        color: #555555;
        line-height: 1.6;
      }
      .button {
        display: inline-block;
        margin: 20px 0;
        background-color: #007bff;
        color: white !important;
        padding: 12px 24px;
        text-decoration: none;
        border-radius: 5px;
        font-weight: bold;
      }
      .footer {
        font-size: 12px;
        color: #999999;
        text-align: center;
        padding-top: 20px;
      }
  body
    .container
      .header
        img(src="https://ibb.co/NnJHKJB2", alt="Company Logo")
        h1 Email-confirmation
      .content
        p Hello #{userName},<br>
          We received a request to reset your password. If you made this request, please click the button below to reset your password:
        a.button(href=url) Reset Your Password
        p If you did not request a password reset, please ignore this email.
      .footer
        p This email was sent to #{userName}. If you did not request a password reset, please disregard this message.