generator client {
  provider = "prisma-client-js"
  output   = "../../../libs/common/src/infrastructure/prisma/generated/order"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id        Int     @id @default(autoincrement())
  customerId Int
  zipCode   Int
  city      String
  dayOfWeek Int    // день заказа
  fromTime  String   // "16:00"
  toTime    String   // "17:00"
  status    OrderStatus? @default(PENDING)
  cleanerId Int?     // заполнится, когда кто-то подтвердит
  clarifications String? @default("") 

  @@index([id])
}

model OrderOutbox {
  id            String   @id @default(uuid())
  aggregateType String   @map("aggregatetype") // В коде camelCase, в БД snake_case
  aggregateId   Int      @map("aggregateid")   // В коде camelCase, в БД snake_case
  payload       Json
  createdAt     DateTime @default(now()) @map("createdat")

  @@map("order_outbox") // Саму таблицу тоже лучше в нижний регистр
}

enum OutboxOrderStatus{
  NEW
  SENT
  ERROR
}

enum OrderStatus {
  INVITED
  DONE
  EXPIRED
  IN_PROGRESS
  WAITING_FRO_CLEANER 
  PENDING
}