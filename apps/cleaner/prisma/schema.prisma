generator client {
  provider = "prisma-client-js"
  output   = "../../../libs/common/src/infrastructure/prisma/generated/cleaner"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CleanerProfile {
  id              Int      @id @default(autoincrement())
  userId          Int @unique     // ID из user-service (для связи между сервисами)
  firstName       String? @default("")
  lastName        String? @default("")
  zipCode         Int? @default(0)
  city            String? @default("")
  experienceYears Int? @default(0)
  rating          Int?   @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  busy            Boolean @default(false)

  schedules       CleanerScheduleDay[]
  reviews         CleanerReview[]
  jobs            CleanerJob[]

  @@index([zipCode, city, id, userId])
}


model CleanerScheduleDay {
  id               Int      @id @default(autoincrement())
  cleanerProfileId Int

  dayOfWeek        Int 
  createdAt        DateTime?  @default(now())

  slots            CleanerScheduleSlot[]
  cleanerProfile   CleanerProfile @relation(fields: [cleanerProfileId], references: [id])

  @@unique([cleanerProfileId, dayOfWeek])
}

model CleanerScheduleSlot {
  id                   Int      @id @default(autoincrement())
  scheduleDayId        Int

  startTime            String?   // ← опционально
  endTime              String?   // ← опционально
  isAvailable          Boolean   @default(true)
  createdAt            DateTime  @default(now())

  scheduleDay          CleanerScheduleDay @relation(fields: [scheduleDayId], references: [id])

  @@index([scheduleDayId, isAvailable])
}

model CleanerReview {
  id               Int      @id @default(autoincrement())
  cleanerProfileId Int

  customerId       Int?      // ← было обязательно → теперь опционально
  rating           Int?      // ← было обязательно → теперь опционально
  comment          String?
  createdAt        DateTime @default(now())

  cleanerProfile   CleanerProfile @relation(fields: [cleanerProfileId], references: [id])
}

model CleanerJob {
  id               Int      @id @default(autoincrement())
  cleanerProfileId Int

  orderId          Int
  status           JobStatus? @default(INVITED)
  paymentStatus    String?  // ← опционально
  createdAt        DateTime? @default(now())
  updatedAt        DateTime? @updatedAt

  cleanerProfile   CleanerProfile @relation(fields: [cleanerProfileId], references: [id])
}

model CleanerOutbox {
  id            String   @id @default(uuid())
  aggregateType String   @map("aggregatetype")
  aggregateId   Int      @map("aggregateid")
  payload       Json
  createdAt     DateTime @default(now()) @map("createdat")

  @@map("cleaner_outbox")
}
enum OutboxCleanerStatus{
  NEW
  SENT
  ERROR
}
enum JobStatus{
  ACCEPTED
  INVITED
  DECLINED
  EXPIRED
}