

generator client {
  provider = "prisma-client-js"
  output   = "../../../libs/auth/src/infrastructure/prisma/generated"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Auth {
  id            Int   @id @default(autoincrement())
  userId        Int   // без связи — просто UUID пользователя
  refreshToken  String?
  createdAt     DateTime @default(now())
  expiresAt     DateTime?
  @@map("auth")
  @@index([userId])
  @@index([expiresAt])
  
}

model AuthOutbox{
  id            Int     @id @default(autoincrement())
  aggregateType String   @map("aggregatetype")
  aggregateId   Int      @map("aggregateid")
  payload       Json
  createdAt     DateTime @default(now()) @map("createdat")

  @@map("auth_outbox")
}

enum AuthOutboxStatus{
  NEW
  SENT
  ERROR
}