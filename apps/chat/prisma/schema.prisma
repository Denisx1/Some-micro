generator client {
  provider = "prisma-client-js"
  output   = "../../../libs/common/src/infrastructure/prisma/generated/chat"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
// schema.prisma

model ChatRoom {
  id          String    @id @default(uuid())
  orderId     Int    @unique
  customerId  Int
  cleanerId   Int
  createdAt   DateTime  @default(now())
  messages    ChatMessage[]

  @@index([orderId]) // Индекс для быстрого поиска комнаты по заказу
}

model ChatMessage {
  id        String   @id @default(uuid())
  senderId  Int   // Кто отправил (ID юзера)
  receiverId Int
  text      String
  createdAt DateTime @default(now())

  roomId    String
  room      ChatRoom @relation(fields: [roomId], references: [id])
  @@index([roomId]) // Индекс для быстрой загрузки истории сообщений
} 

model ChatOutbox{
   id            String   @id @default(uuid())
  aggregateType String   @map("aggregatetype")
  aggregateId   Int      @map("aggregateid")
  payload       Json
  createdAt     DateTime @default(now()) @map("createdat")

  @@map("chat_outbox")
}
