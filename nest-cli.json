{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/apigateway/src",
  "monorepo": true,
  "root": "apps/apigateway",
  "compilerOptions": {
    "webpack": true,
    "tsConfigPath": "tsconfig.build.json"
  },
  "projects": {
    "auth": {
      "type": "application",
      "root": "apps/auth",
      "entryFile": "main",
      "sourceRoot": "apps/auth/src",
      "compilerOptions": {
        "tsConfigPath": "apps/auth/tsconfig.app.json",
        "assets": ["proto/*.proto"],
        "watchAssets": true
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src"
    },
    "gateway": {
      "type": "application",
      "root": "apps/gateway",
      "entryFile": "main",
      "sourceRoot": "apps/gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/gateway/tsconfig.app.json",
        "assets": ["proto/*.proto"],
        "watchAssets": true
      }
    },
    "chat": {
      "type": "application",
      "root": "apps/chat",
      "entryFile": "main",
      "sourceRoot": "apps/chat/src",
      "compilerOptions": {
        "tsConfigPath": "apps/chat/tsconfig.app.json",
        "assets": ["proto/*.proto"],
        "watchAssets": true
      }
    },
    "projection": {
      "type": "application",
      "root": "apps/projection",
      "entryFile": "main",
      "sourceRoot": "apps/projection/src",
      "compilerOptions": {
        "tsConfigPath": "apps/projection/tsconfig.app.json",
        "assets": ["proto/*.proto"]
      }
    },
    "user": {
      "type": "application",
      "root": "apps/user",
      "entryFile": "main",
      "sourceRoot": "apps/user/src",
      "compilerOptions": {
        "tsConfigPath": "apps/user/tsconfig.app.json",
        "watchAssets": true
      }
    },
    "registration": {
      "type": "application",
      "root": "apps/registration",
      "entryFile": "main",
      "sourceRoot": "apps/registration/src",
      "compilerOptions": {
        "tsConfigPath": "apps/registration/tsconfig.app.json",
        "watchAssets": true
      }
    },
    "customer": {
      "type": "application",
      "root": "apps/customer",
      "entryFile": "main",
      "sourceRoot": "apps/customer/src",
      "compilerOptions": {
        "tsConfigPath": "apps/customer/tsconfig.app.json",
        "watchAssets": true
      }
    },
    "cleaner": {
      "type": "application",
      "root": "apps/cleaner",
      "entryFile": "main",
      "sourceRoot": "apps/cleaner/src",
      "compilerOptions": {
        "tsConfigPath": "apps/cleaner/tsconfig.app.json",
        "watchAssets": true
      }
    },
    "order": {
      "type": "application",
      "root": "apps/order",
      "entryFile": "main",
      "sourceRoot": "apps/order/src",
      "compilerOptions": {
        "tsConfigPath": "apps/order/tsconfig.app.json",
        "watchAssets": true
      }
    },
    "notification": {
      "type": "application",
      "root": "apps/notification",
      "entryFile": "main",
      "sourceRoot": "apps/notification/src",
      "compilerOptions": {
        "tsConfigPath": "apps/notification/tsconfig.app.json",

        "watchAssets": true
      }
    }
  }
}
